# HC_storage — copy to ~/.hc_storage.env and fill in values.
# Load with:  set -a; source ~/.hc_storage.env; set +a
#
# Do NOT commit real passwords/keys into git.

# TempAuth (used once Swift proxy is up on sw-proxy)
ST_AUTH=http://172.30.201.247:8080/auth/v1.0
ST_USER=test:tester
ST_KEY=testing

# Containers (created in a later milestone)
HOT_CONTAINER=hot-objects
COLD_CONTAINER=cold-objects

# Host paths (laptop ingest pipeline)
HC_DATA_ROOT=${HOME}/HC_storage_data
READY_FOR_HOT=${HC_DATA_ROOT}/ready_for_hot
UPLOADING_HOT=${HC_DATA_ROOT}/uploading_hot
UPLOADED_HOT=${HC_DATA_ROOT}/uploaded_hot
HC_LOG_DIR=${HC_DATA_ROOT}/logs

# Which uploader cron to enable: cli | api | none
# Enable only ONE in crontab to avoid double work (files are claim-moved anyway).
HOT_UPLOAD_BACKEND=cli

# Hot → Cold tiering (minutes). Lab default is short; raise for demos.
TIER_AGE_THRESHOLD_MINUTES=30
TIER_MAX_OBJECTS=50
HC_LOCATION_INDEX=${HC_DATA_ROOT}/location_index.jsonl
